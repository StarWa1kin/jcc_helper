{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "金铲铲军师"
			}
		},
		{
			"path": "pages/season/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "赛季资料"
			}
		},
		{
			"path": "pages/season/detail",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "英雄详情"
			}
		},
		{
			"path": "pages/ai/index",
			"style": {
				"navigationBarTitleText": "AI阵容"
			}
		},
		{
			"path": "pages/profile/index",
			"style": {
				"navigationBarTitleText": "我的"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "金铲铲军师",
		"navigationBarBackgroundColor": "#F5F3FB",
		"backgroundColor": "#F5F3FB"
	},
	"tabBar": {
		"color": "#93A4BF",
		"selectedColor": "#30106F",
		"backgroundColor": "#FFFFFF",
		"borderStyle": "white",
		"list": [
			{
				"pagePath": "pages/index/index",
				"text": "首页"
			},
			{
				"pagePath": "pages/season/index",
				"text": "赛季资料"
			},
			{
				"pagePath": "pages/ai/index",
				"text": "AI阵容"
			},
			{
				"pagePath": "pages/profile/index",
				"text": "我的"
			}
		]
	}
}
